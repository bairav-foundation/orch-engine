.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local config / secrets
.env
.env.local
*.local

# Build artifacts
*.tar.gz
*.zip

# Generated / operator scaffolding. Anchored: an unanchored "config/manager/"
# also matched operator/config/manager/, the hand-written manifests
# `make install-operator` applies (new files there were silently ignored).
/testbin/
/operator/testbin/

# Model cache (local dev). Anchored for the same reason: "models/" matched
# any directory of that name anywhere in the tree.
/.bairav-cache/
/models/
